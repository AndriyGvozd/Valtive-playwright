# Copy to .env and fill in as needed.

# Overrides the default https://valtive.io target, e.g. for staging/preview.
# BASE_URL=https://staging.valtive.io

# Fill in to enable automatic result upload to Qase TMS.
# Leave QASE_MODE unset (or anything other than "testops") to run tests without Qase.
QASE_MODE=testops
QASE_TESTOPS_API_TOKEN=
QASE_TESTOPS_PROJECT=
# Optional: reuse an existing run instead of creating a new one per invocation.
# QASE_TESTOPS_RUN_ID=
